  "dependencies": {
    "@collab/crdt": "workspace:*",
    "@collab/protocol": "workspace:*",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "vitest": "^5.0.4"
  }
}
