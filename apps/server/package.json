{
  "name": "@collab/server",
  "version": "0.0.0",
  "private": true,
  "description": "WebSocket sync server: rooms, presence, backpressure, Postgres op log + snapshots, Redis fan-out.",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
